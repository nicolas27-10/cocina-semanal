---
import Base from '@/components/Base.astro';
import GeneradorReceta from '@/islands/GeneradorReceta';
import { lunesDe } from '@/lib/semana';
import type { RecetaResumen } from '@/lib/tipos';

const { supabase } = Astro.locals;

const [{ data: filas }, { data: sinPuente }] = await Promise.all([
  supabase
    .from('recetas')
    .select('id, slug, titulo, resumen, porciones, min_prep, min_coccion, etiquetas, origen')
    .order('created_at', { ascending: false }),
  // Vista de diagnostico: cada fila aca es una linea que va a salir como
  // "revisar" en la lista de compras.
  supabase.from('ingredientes_sin_puente').select('nombre, unidad_usada, falta').limit(10),
]);

const recetas = (filas ?? []) as (RecetaResumen & { resumen: string | null })[];
---

<Base titulo="Recetas" ancho="amplio">
  <p class="font-mono text-xs uppercase tracking-[0.14em] text-albahaca-600">Recetario</p>
  <h1 class="mt-1.5 text-2xl font-semibold">Recetas</h1>
  <p class="mt-2 max-w-[60ch] text-hueso-700">
    Contale a la IA que se te antoja cocinar — aunque sea solo una idea — y arma la receta con
    ingredientes vinculados al catalogo. Despues asignas cada receta a un dia en
    <a href={`/app/semana/${lunesDe()}`} class="font-semibold text-albahaca-600 underline">
      el plan de la semana
    </a>
    y ahi se calcula la lista de compras, restando lo que ya tienes en la despensa.
  </p>

  <div class="mt-6">
    <GeneradorReceta client:load />
  </div>

  {
    sinPuente && sinPuente.length > 0 && (
      <div class="mt-6 rounded-lg border border-alerta-500/30 bg-alerta-50 p-4">
        <h2 class="font-mono text-xs uppercase tracking-[0.14em] text-alerta-500">
          Conversiones incompletas
        </h2>
        <p class="mt-1.5 max-w-[65ch] text-sm text-hueso-700">
          Estos ingredientes se usan con una unidad que no se puede convertir a su unidad base.
          Van a salir como &ldquo;revisar&rdquo; en la lista hasta que completes el dato.
        </p>
        <ul class="mt-2 space-y-0.5 font-mono text-[13px] text-hueso-700">
          {sinPuente.map((f: { nombre: string; unidad_usada: string; falta: string }) => (
            <li>
              {f.nombre} <span class="text-hueso-500">en {f.unidad_usada} —</span> {f.falta}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <h2 class="mt-10 text-lg font-semibold">
    {recetas.length} {recetas.length === 1 ? 'receta' : 'recetas'}
  </h2>

  {
    recetas.length === 0 ? (
      <p class="mt-3 rounded-lg border border-dashed border-hueso-300 p-6 text-center text-sm text-hueso-500">
        Todavia no hay recetas. Genera las primeras arriba, o agrega una a mano.
      </p>
    ) : (
      <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {recetas.map((receta) => (
          <li class="rounded-xl border border-hueso-200 bg-white p-4">
            <a href={`/app/recetas/${receta.slug}`} class="group block">
              <h3 class="text-base font-semibold leading-snug group-hover:text-albahaca-700">
                {receta.titulo}
              </h3>
              {receta.resumen && (
                <p class="mt-1.5 line-clamp-2 text-sm text-hueso-700">{receta.resumen}</p>
              )}
              <p class="mt-2.5 flex flex-wrap items-center gap-2 font-mono text-[11px] text-hueso-500">
                <span>{receta.porciones} porc.</span>
                <span>{(receta.min_prep ?? 0) + (receta.min_coccion ?? 0)} min</span>
                {receta.origen === 'ia' && <span class="text-albahaca-600">generada</span>}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
