---
import Base from '@/components/Base.astro';

const { slug } = Astro.params;
const { supabase } = Astro.locals;

const { data: receta } = await supabase
  .from('recetas')
  .select(
    `id, titulo, resumen, porciones, min_prep, min_coccion, pasos, etiquetas, origen,
     receta_ingredientes(cantidad, unidad_code, nota, opcional, orden,
       ingredientes(nombre, pasillo))`,
  )
  .eq('slug', slug!)
  .maybeSingle();

if (!receta) return new Response('Receta no encontrada', { status: 404 });

// Supabase tipa las relaciones anidadas como arreglo aunque en una
// many-to-one devuelva un objeto. Se acepta cualquiera de las dos formas en
// vez de forzar el tipo y descubrirlo en produccion.
type Anidado = { nombre: string } | { nombre: string }[] | null;

type Fila = {
  cantidad: number | null;
  unidad_code: string | null;
  nota: string | null;
  opcional: boolean;
  orden: number;
  ingredientes: Anidado;
};

const nombreDe = (valor: Anidado): string =>
  (Array.isArray(valor) ? valor[0]?.nombre : valor?.nombre) ?? 'ingrediente';

const ingredientes = ((receta.receta_ingredientes ?? []) as unknown as Fila[]).sort(
  (a, b) => a.orden - b.orden,
);
const pasos = (receta.pasos ?? []) as string[];
const minutos = (receta.min_prep ?? 0) + (receta.min_coccion ?? 0);
---

<Base titulo={receta.titulo as string}>
  <a href="/app/recetas" class="text-sm font-semibold text-albahaca-600 hover:underline">
    &larr; Recetas
  </a>

  <h1 class="mt-4 text-3xl font-semibold leading-tight">{receta.titulo}</h1>
  {receta.resumen && <p class="mt-2 max-w-[62ch] text-lg text-hueso-700">{receta.resumen}</p>}

  <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-2 border-y border-hueso-200 py-3 font-mono text-[13px]">
    <div class="flex gap-2">
      <dt class="text-hueso-500">Porciones</dt>
      <dd class="tabular font-semibold">{receta.porciones}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="text-hueso-500">Prep</dt>
      <dd class="tabular font-semibold">{receta.min_prep ?? 0} min</dd>
    </div>
    <div class="flex gap-2">
      <dt class="text-hueso-500">Coccion</dt>
      <dd class="tabular font-semibold">{receta.min_coccion ?? 0} min</dd>
    </div>
    <div class="flex gap-2">
      <dt class="text-hueso-500">Total</dt>
      <dd class="tabular font-semibold">{minutos} min</dd>
    </div>
  </dl>

  <div class="mt-8 grid gap-8 sm:grid-cols-[220px_minmax(0,1fr)]">
    <section>
      <h2 class="font-mono text-xs uppercase tracking-[0.14em] text-albahaca-600">Ingredientes</h2>
      <ul class="mt-3 divide-y divide-hueso-100 border-t border-hueso-100 text-sm">
        {
          ingredientes.map((ing) => (
            <li class="flex items-baseline justify-between gap-3 py-2">
              <span>
                {nombreDe(ing.ingredientes)}
                {ing.nota && <span class="block text-[12px] text-hueso-500">{ing.nota}</span>}
                {ing.opcional && (
                  <span class="ml-1 font-mono text-[11px] text-hueso-500">opcional</span>
                )}
              </span>
              <span class="shrink-0 font-mono text-[13px] tabular text-hueso-700">
                {ing.cantidad === null
                  ? 'a gusto'
                  : `${ing.cantidad} ${ing.unidad_code ?? ''}`.trim()}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-[12px] leading-relaxed text-hueso-500">
        Los &ldquo;a gusto&rdquo; y las unidades sin conversion no se suman a la lista de compras:
        aparecen ahi como &ldquo;revisar&rdquo;.
      </p>
    </section>

    <section>
      <h2 class="font-mono text-xs uppercase tracking-[0.14em] text-albahaca-600">Preparacion</h2>
      <ol class="mt-3 space-y-3">
        {
          pasos.map((paso, i) => (
            <li class="flex gap-3">
              <span class="mt-0.5 shrink-0 font-mono text-xs text-hueso-300 tabular">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="max-w-[62ch] leading-relaxed">{paso}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>
