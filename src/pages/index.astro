---
import Base from '@/components/Base.astro';
import { lunesDe } from '@/lib/semana';

// La landing no depende del usuario: se puede prerenderizar y servir
// estatica desde el CDN de Netlify, sin invocar una funcion.
export const prerender = true;

const semana = lunesDe();

const pasos = [
  {
    titulo: 'Armas la semana',
    texto: 'Arrastras recetas a las 21 casillas de la semana. Cambias porciones si viene gente.',
  },
  {
    titulo: 'Se calcula la compra',
    texto:
      'Se suman los ingredientes de todas las recetas, se convierten a una misma unidad, se resta lo que ya tienes y se redondea al formato en que se vende.',
  },
  {
    titulo: 'Compras una vez',
    texto: 'La lista sale ordenada por pasillo, en el orden en que recorres el local.',
  },
];
---

<Base
  titulo="Menu semanal y lista de compras"
  descripcion="Planifica la semana, guarda tus recetas y genera la lista de compras del mes."
>
  <section class="py-6">
    <p class="font-mono text-xs uppercase tracking-[0.14em] text-albahaca-600">
      Planificacion de comidas en casa
    </p>
    <h1 class="mt-3 text-4xl font-semibold leading-[1.1] sm:text-5xl">
      La semana resuelta, y una sola compra.
    </h1>
    <p class="mt-5 max-w-[60ch] text-lg leading-relaxed text-hueso-700">
      Planificas las comidas de la semana, y la lista de compras se calcula sola: suma los
      ingredientes de todas las recetas, resta lo que ya hay en la despensa y te dice cuanto
      comprar en el formato en que se vende.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={`/app/semana/${semana}`}
        class="rounded-lg bg-albahaca-600 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-albahaca-700"
      >
        Armar esta semana
      </a>
      <a
        href="/app/recetas"
        class="rounded-lg border border-hueso-300 px-5 py-2.5 font-semibold text-hueso-700 transition-colors hover:bg-hueso-100"
      >
        Ver recetas
      </a>
    </div>
  </section>

  <ol class="mt-10 grid gap-px overflow-hidden rounded-xl border border-hueso-200 bg-hueso-200 sm:grid-cols-3">
    {
      pasos.map((paso, i) => (
        <li class="bg-white p-5">
          <span class="font-mono text-xs text-albahaca-600">0{i + 1}</span>
          <h2 class="mt-2 text-base font-semibold">{paso.titulo}</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-hueso-700">{paso.texto}</p>
        </li>
      ))
    }
  </ol>
</Base>
